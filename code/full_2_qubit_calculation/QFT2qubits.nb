Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"QFT", "=", 
   RowBox[{"FourierMatrix", "[", "4", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9514533265365458`*^9, 3.9514533375799065`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"e8b85a88-8355-43c0-8c7f-aa52bff5c02e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cl2", "=", 
   RowBox[{
   "Import", "[", 
    "\"\<C:\\\\Users\\\\gianl\\\\OneDrive - Universit\[AGrave] di Napoli \
Federico II\\\\mathematica\\\\2qubitclifford_symbolical.m\>\"", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.951453341283546*^9, 3.9514533622472105`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"c0834bfa-12e6-420b-bbaf-97ebf3be9d81"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9514533659937787`*^9, 
  3.9514533899861107`*^9}},ExpressionUUID->"8b71d47a-5abc-4ef1-9e37-\
12f8282865a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
     RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
     RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P2", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"P", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"P", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "[", "x_", "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"Log", "[", 
    RowBox[{
     FractionBox["1", "4"], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"P2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ".", "x"}], "]"}], "^", "4"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "P2", "]"}]}], "}"}]}], "]"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zero", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zerozero", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"zero", ",", "zero"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"omega0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"zerozero", ",", 
     RowBox[{"zerozero", "\[ConjugateTranspose]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.951453439392292*^9, 3.951453440066941*^9}, 
   3.9514535558094935`*^9, 3.9514537102999153`*^9},
 CellLabel->"In[26]:=",ExpressionUUID->"5d992ff7-d155-4315-91a8-d6ef65cbc332"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QFTpnn", "=", 
  RowBox[{"Parallelize", "[", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"m2", "[", 
      RowBox[{"QFT", ".", 
       RowBox[{"cl2", "[", 
        RowBox[{"[", "s", "]"}], "]"}], ".", "omega0", ".", 
       RowBox[{
        RowBox[{"cl2", "[", 
         RowBox[{"[", "s", "]"}], "]"}], "\[ConjugateTranspose]"}], ".", 
       RowBox[{"QFT", "\[ConjugateTranspose]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "1", ",", 
       RowBox[{"Length", "[", "cl2", "]"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9514533768546066`*^9, 3.951453382781355*^9}, {
  3.951453459270625*^9, 3.9514535055749645`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"c3550894-890d-449d-8047-20dc53d2726d"],

Cell[BoxData[
 RowBox[{"6144", " ", 
  RowBox[{"Log", "[", 
   FractionBox["16", "7"], "]"}]}]], "Output",
 CellChangeTimes->{3.951453378805743*^9, 3.9514535221814013`*^9, 
  3.9514535605269823`*^9, 3.9514537161711864`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"32b34829-b9c5-4cd9-b866-224d439a7f87"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QFTPower", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QFTpnn", "/", "11520"}], "/.", 
     RowBox[{"Log", "->", "Log2"}]}], "/.", 
    RowBox[{
     RowBox[{"Log2", "[", 
      RowBox[{"16", "/", "7"}], "]"}], "->", 
     RowBox[{
      RowBox[{"Log2", "[", "16", "]"}], "-", 
      RowBox[{"Log2", "[", "7", "]"}]}]}]}], "//", "N"}]}]], "Input",
