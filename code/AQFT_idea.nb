Notebook[{

Cell[CellGroupData[{
Cell["2 qubit commutator for CONTROL+S gate", "Title",
 CellChangeTimes->{{3.922333215308733*^9, 
  3.922333250105555*^9}},ExpressionUUID->"83a798bc-b0f2-4c61-b702-\
11423ca03b72"],

Cell["Numerical calculation", "Subtitle",
 CellChangeTimes->{{3.922333259417836*^9, 
  3.922333264564752*^9}},ExpressionUUID->"df742638-9226-48ce-955b-\
503a313dd219"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"Sqrt", "[", "2", "]"}]], "*", 
    RowBox[{"(", GridBox[{
       {"1", "1"},
       {"1", 
        RowBox[{"-", "1"}]}
      }], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iden", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{"(", GridBox[{
      {"0", "1"},
      {"1", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "I"}]},
      {"I", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", 
       RowBox[{"-", "1"}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "=", 
    RowBox[{"(", GridBox[{
       {"1", "0"},
       {"0", 
        SuperscriptBox["E", 
         RowBox[{"I", "*", 
          RowBox[{"Pi", "/", "2"}]}]]}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zerozero", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oneone", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u2", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"zerozero", ",", "S"}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"oneone", ",", "iden"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parser", "[", "p_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p", "===", "0"}], ",", "iden", ",", 
     RowBox[{"p", "===", "1"}], ",", "X", ",", 
     RowBox[{"p", "===", "2"}], ",", "Y", ",", 
     RowBox[{"p", "===", "3"}], ",", "Z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PauliString", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"parser", "[", "i", "]"}], ",", 
     RowBox[{"parser", "[", "j", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}], ".", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], " ", "-", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}], ",", 
         RowBox[{"PauliString", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ".", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}]}]}], " ", ",", 
     
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"pp", ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.922333281934503*^9, 3.922333289689604*^9}, {
  3.9223337170132923`*^9, 3.922333725219015*^9}, {3.931259361571369*^9, 
  3.931259363184534*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"a3c03cc4-1541-426d-b498-35cf3248c700"],

