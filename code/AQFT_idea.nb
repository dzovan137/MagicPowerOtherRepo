Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"Sqrt", "[", "2", "]"}]], "*", 
    RowBox[{"(", GridBox[{
       {"1", "1"},
       {"1", 
        RowBox[{"-", "1"}]}
      }], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iden", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{"(", GridBox[{
      {"0", "1"},
      {"1", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "I"}]},
      {"I", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", 
       RowBox[{"-", "1"}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "=", 
    RowBox[{"(", GridBox[{
       {"1", "0"},
       {"0", 
        SuperscriptBox["E", 
         RowBox[{"I", "*", 
          RowBox[{"Pi", "/", "2"}]}]]}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zerozero", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oneone", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u2", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"iden", ",", "zerozero", ",", "S"}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"iden", ",", "oneone", ",", "iden"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parser", "[", "p_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p", "===", "0"}], ",", "iden", ",", 
     RowBox[{"p", "===", "1"}], ",", "X", ",", 
     RowBox[{"p", "===", "2"}], ",", "Y", ",", 
     RowBox[{"p", "===", "3"}], ",", "Z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PauliString", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"parser", "[", "i", "]"}], ",", 
     RowBox[{"parser", "[", "j", "]"}], ",", 
     RowBox[{"parser", "[", "k", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pp", "=", 
   RowBox[{"Parallelize", "[", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}], ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "]"}]}], " ", "-", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "]"}], ".", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}]}]}], " ", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"pp", ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Detailed\>\""}]}], "]"}]}], "Input",
