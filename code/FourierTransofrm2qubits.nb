   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oneone", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u2", "=", 
   RowBox[{"FourierMatrix", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parser", "[", "p_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p", "===", "0"}], ",", "iden", ",", 
     RowBox[{"p", "===", "1"}], ",", "X", ",", 
     RowBox[{"p", "===", "2"}], ",", "Y", ",", 
     RowBox[{"p", "===", "3"}], ",", "Z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PauliString", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"parser", "[", "i", "]"}], ",", 
     RowBox[{"parser", "[", "j", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"pp", "=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}], ".", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], " ", "-", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"PauliString", "[", 
         RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ".", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"u2", ",", "u2", ",", "u2", ",", "u2"}], "]"}]}]}], " ", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
