Cell["\<\
Compute the application of the computed commutator and the Permutation Matrix\
\
\>", "Text",
 CellChangeTimes->{{3.922361216535967*^9, 
  3.922361237251845*^9}},ExpressionUUID->"fe89fae3-c564-417d-9170-\
cee94790b0ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"oo", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", "16"}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "/", "24"}], ")"}], "*", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"pp", ".", 
      RowBox[{"permutationMatrix", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"permdouble", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "24"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.922358989870687*^9, 3.922359022962778*^9}, {
