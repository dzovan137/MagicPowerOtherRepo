Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"parser", "[", "p_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p", "===", "0"}], ",", "iden", ",", 
     RowBox[{"p", "===", "1"}], ",", "X", ",", 
     RowBox[{"p", "===", "2"}], ",", "Y", ",", 
     RowBox[{"p", "===", "3"}], ",", "Z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PauliString", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"parser", "[", "i", "]"}], ",", 
     RowBox[{"parser", "[", "j", "]"}], ",", 
     RowBox[{"parser", "[", "k", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"PPP", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliString", "[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
       RowBox[{"PauliString", "[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
       RowBox[{"PauliString", "[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
       RowBox[{"PauliString", "[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], "Input",
