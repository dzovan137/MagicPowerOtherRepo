      {"I", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", 
       RowBox[{"-", "1"}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "=", 
    RowBox[{"(", GridBox[{
       {"1", "0"},
       {"0", 
        SuperscriptBox["E", 
         RowBox[{"I", "*", 
          RowBox[{"Pi", "/", "2"}]}]]}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zerozero", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oneone", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u2", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"zerozero", ",", "S"}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"oneone", ",", "iden"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parser", "[", "p_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"p", "===", "0"}], ",", "iden", ",", 
     RowBox[{"p", "===", "1"}], ",", "X", ",", 
     RowBox[{"p", "===", "2"}], ",", "Y", ",", 
     RowBox[{"p", "===", "3"}], ",", "Z"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PauliString", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"parser", "[", "i", "]"}], ",", 
