Cell[CellGroupData[{

Cell["Analytic - Symbolic Algebra calculation", "Subtitle",
 CellChangeTimes->{{3.92233376133674*^9, 
  3.922333781761158*^9}},ExpressionUUID->"91728123-71d2-4400-a69d-\
1f3830cb9e0e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"II", ",", "X", ",", "Y", ",", "Z"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"first", "[", 
     RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
    RowBox[{"Which", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "===", "II"}], " ", "&&", " ", 
        RowBox[{"B", "===", "II"}]}], ")"}], ",", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{"0", ",", 
        RowBox[{"II", "+", "Z", "+", 
         RowBox[{"I", "*", 
          RowBox[{"(", 
           RowBox[{"II", "-", "Z"}], ")"}]}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "===", "II"}], " ", "&&", " ", 
        RowBox[{"B", "===", "X"}]}], ")"}], ",", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "I"}], ")"}], "*", "X"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "===", "II"}], " ", "&&", " ", 
        RowBox[{"B", "===", "Y"}]}], ")"}], ",", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "I"}], ")"}], "*", "Y"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "===", "II"}], " ", "&&", " ", 
        RowBox[{"B", "===", "Z"}]}], ")"}], ",", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{"0", ",", 
        RowBox[{"II", "+", "Z", "-", 
         RowBox[{"I", "*", 
          RowBox[{"(", 
           RowBox[{"II", "-", "Z"}], ")"}]}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(", 
