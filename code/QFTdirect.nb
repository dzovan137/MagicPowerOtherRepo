          RowBox[{"(", 
           RowBox[{"d", "+", "4"}], ")"}]}]], "*", "a"}], "+", 
       RowBox[{
        FractionBox["24", 
         RowBox[{"d", "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "4"}], ")"}]}]], "*", "b"}]}], ")"}]}]}]}], 
  ";"}]], "Input",
