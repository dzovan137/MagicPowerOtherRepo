Notebook[{

Cell[CellGroupData[{
Cell["Application of the Permutation Matrix", "Title",
 CellChangeTimes->{{3.922361102987925*^9, 
  3.922361117586525*^9}},ExpressionUUID->"f17188d1-b80e-4a6a-8f35-\
57ceff0634ce"],

Cell["Define the function to generate the Permutation Matrix", "Text",
 CellChangeTimes->{{3.922361135889831*^9, 
  3.922361150039427*^9}},ExpressionUUID->"8211bffa-741e-44d1-974e-\
7717affa31e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"indexToQubitIndices", "[", 
    RowBox[{"n_", ",", "numQubits_"}], "]"}], ":=", 
   RowBox[{"PadLeft", "[", 
    RowBox[{
     RowBox[{"IntegerDigits", "[", 
      RowBox[{
       RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], ",", "numQubits"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permutationMatrix", "[", "permutation_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numQubits", "=", 
       RowBox[{"Length", "@", "permutation"}]}], "}"}], ",", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i_", ",", "j_"}], "}"}], "\[RuleDelayed]", 
         RowBox[{"1", "/;", 
          RowBox[{"Equal", "[", 
           RowBox[{
            RowBox[{"Permute", "[", 
             RowBox[{
              RowBox[{"indexToQubitIndices", "[", 
               RowBox[{"i", ",", "numQubits"}], "]"}], ",", "permutation"}], 
             "]"}], ",", 
            RowBox[{"indexToQubitIndices", "[", 
             RowBox[{"j", ",", "numQubits"}], "]"}]}], "]"}]}]}], "}"}], ",", 
       
       RowBox[{
        RowBox[{"2", "^", "numQubits"}], " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9223500719378767`*^9, 3.922350114683259*^9}, {
   3.92235024334577*^9, 3.922350247159582*^9}, {3.922350302650443*^9, 
   3.922350305606201*^9}, {3.922350586303117*^9, 3.922350651881432*^9}, {
   3.922350702709063*^9, 3.922350757090578*^9}, {3.9223508095023518`*^9, 
   3.922350836484334*^9}, {3.922351050281934*^9, 3.922351082179751*^9}, {
   3.9223573635669193`*^9, 3.922357363620899*^9}, {3.922357514580325*^9, 
   3.9223575261813307`*^9}, {3.922357629802597*^9, 3.922357629875246*^9}, {
   3.922357710875414*^9, 3.922357791131832*^9}, {3.922358010692485*^9, 
   3.922358026029416*^9}, {3.9223580615476837`*^9, 3.922358067345829*^9}, {
   3.922358426846517*^9, 3.92235843185319*^9}, 3.922361131517055*^9, {
   3.9240752794919*^9, 3.924075281191881*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"471f6614-d482-42d6-9c2c-1a35fe44d9c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"T", " ", "=", 
   RowBox[{"permutationMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.924075290404129*^9, 3.9240752933631163`*^9}, {
  3.9240753672243958`*^9, 3.9240753681214123`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"d41e758e-ec23-4139-90c5-2bd54469f606"],

Cell[CellGroupData[{

