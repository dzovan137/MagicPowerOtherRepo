e784b7b462c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Generated", " ", "by", " ", "the", " ", "4", " ", "Pauli", " ", "strings",
     " ", "on", " ", "1", " ", "qubit", " ", "but", " ", "taken", " ", "to", 
    " ", "4", " ", "times", " ", "replicated", " ", "space"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PauliString1", "[", "i_", "]"}], ":=", 
     RowBox[{"PauliMatrix", "[", "i", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generated", " ", "by", " ", "the", " ", "16", " ", "Pauli", " ", 
     "strings", " ", "on", " ", "2", " ", "qubits", " ", "but", " ", "taken", 
     " ", "to", " ", "4", " ", "times", " ", "replicated", " ", "space"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PauliString2", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "i", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "16"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generated", " ", "by", " ", "the", " ", "16", " ", "Pauli", " ", 
     "strings", " ", "on", " ", "2", " ", "qubits", " ", "but", " ", "taken", 
     " ", "to", " ", "4", " ", "times", " ", "replicated", " ", "space"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PauliString3", "[", 
      RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "i", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "k", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q3", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "64"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n"}]}]], "Code",
 CellChangeTimes->{{3.923471270162422*^9, 3.9234714163197947`*^9}, {
   3.923471451824225*^9, 3.9234716122548237`*^9}, 3.9234716565591583`*^9, {
