Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Generated", " ", "by", " ", "the", " ", "16", " ", "Pauli", " ", 
    "strings", " ", "on", " ", "2", " ", "qubits", " ", "but", " ", "taken", 
    " ", "to", " ", "4", " ", "times", " ", "replicated", " ", "space"}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PauliString2", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "i", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "16"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "list", " ", "the", " ", "possible", " ", "permutations", " ", "of", " ", 
     "2", " ", "qubits", " ", "on", " ", "4", " ", "times", " ", "replicated",
      " ", "space"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"permdouble", "=", 
     RowBox[{"Permutations", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"total", " ", "operator", " ", "reads"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P2", "=", 
