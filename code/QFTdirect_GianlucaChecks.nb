Cell["Lets define the Permutation operator \\Pi_sim", "Text",
 CellChangeTimes->{{3.92458561806262*^9, 
  3.924585635981592*^9}},ExpressionUUID->"de50bf68-2087-41ec-8667-\
99be0b388352"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "function", " ", "to", " ", "generate", " ", "the", " ", "pertunations"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"indexToQubitIndices", "[", 
      RowBox[{"n_", ",", "numQubits_"}], "]"}], ":=", 
     RowBox[{"PadLeft", "[", 
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], ",", "numQubits"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"permutationMatrix", "[", "permutation_", "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"numQubits", "=", 
         RowBox[{"Length", "@", "permutation"}]}], "}"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"1", "/;", 
            RowBox[{"Equal", "[", 
             RowBox[{
              RowBox[{"Permute", "[", 
               RowBox[{
                RowBox[{"indexToQubitIndices", "[", 
                 RowBox[{"i", ",", "numQubits"}], "]"}], ",", "permutation"}],
                "]"}], ",", 
              RowBox[{"indexToQubitIndices", "[", 
               RowBox[{"j", ",", "numQubits"}], "]"}]}], "]"}]}]}], "}"}], 
         ",", 
         RowBox[{
          RowBox[{"2", "^", "numQubits"}], " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "list", " ", "the", " ", "possible", " ", "permutations", " ", "of", " ", 
     "1", " ", "qubit", " ", "on", " ", "4", " ", "times", " ", "replicated", 
     " ", "space"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"permsingle", "=", 
     RowBox[{"Permutations", "@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"total", " ", "operator", " ", "reads"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "24"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"permutationMatrix", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"permsingle", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "24"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "list", " ", "the", " ", "possible", " ", "permutations", " ", "of", " ", 
     "2", " ", "qubits", " ", "on", " ", "4", " ", "times", " ", "replicated",
      " ", "space"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"permdouble", "=", 
     RowBox[{"Permutations", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "8"}], "}"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"total", " ", "operator", " ", "reads"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "24"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"permutationMatrix", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"permdouble", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "24"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"permtriple", "=", 
      RowBox[{"Permutations", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"7", ",", "8", ",", "9"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "11", ",", "12"}], "}"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"P3", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "24"}], ")"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"permutationMatrix", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"permtriple", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "24"}], "}"}]}], "]"}]}]}], ";"}], 
    "\[IndentingNewLine]", "*)"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9223500719378767`*^9, 3.922350114683259*^9}, {
   3.92235024334577*^9, 3.922350247159582*^9}, {3.922350302650443*^9, 
