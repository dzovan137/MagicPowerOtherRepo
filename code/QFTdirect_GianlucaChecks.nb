   RowBox[{"1", "-", 
    RowBox[{"d", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["6", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
