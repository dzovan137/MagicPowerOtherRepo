Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "function", " ", "to", " ", "generate", " ", "the", " ", "pertunations"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"indexToQubitIndices", "[", 
      RowBox[{"n_", ",", "numQubits_"}], "]"}], ":=", 
     RowBox[{"PadLeft", "[", 
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], ",", "numQubits"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"permutationMatrix", "[", "permutation_", "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"numQubits", "=", 
         RowBox[{"Length", "@", "permutation"}]}], "}"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", "j_"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"1", "/;", 
            RowBox[{"Equal", "[", 
             RowBox[{
              RowBox[{"Permute", "[", 
               RowBox[{
                RowBox[{"indexToQubitIndices", "[", 
                 RowBox[{"i", ",", "numQubits"}], "]"}], ",", "permutation"}],
                "]"}], ",", 
              RowBox[{"indexToQubitIndices", "[", 
               RowBox[{"j", ",", "numQubits"}], "]"}]}], "]"}]}]}], "}"}], 
         ",", 
         RowBox[{
          RowBox[{"2", "^", "numQubits"}], " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 Background->RGBColor[0.94, 0.91, 0.88],
 CellLabel->"In[47]:=",ExpressionUUID->"8c737ca6-cc3d-4426-a0f4-5031a2aa02cd"],

