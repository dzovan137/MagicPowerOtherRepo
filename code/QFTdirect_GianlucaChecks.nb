      RowBox[{"(", 
       RowBox[{"1", "/", "24"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"permutationMatrix", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"permdouble", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "24"}], "}"}]}], "]"}]}]}], ";"}], 
