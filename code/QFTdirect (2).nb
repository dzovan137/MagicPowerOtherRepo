Cell["Linear magic expression", "Text",
 CellChangeTimes->{{3.9245894154571543`*^9, 
  3.924589418230316*^9}},ExpressionUUID->"d97bb76e-1b19-4627-962e-\
6ce61f08cd01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Mlin", "[", 
    RowBox[{"d_", ",", "a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"d", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["6", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "4"}], ")"}]}]], "*", "a"}], "+", 
       RowBox[{
        FractionBox["24", 
         RowBox[{"d", "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"d", "+", "4"}], ")"}]}]], "*", "b"}]}], ")"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.924589425811531*^9, 3.924589569292882*^9}, {
  3.924589894887733*^9, 3.924589905103938*^9}, {3.9245951267898827`*^9, 
  3.924595126873921*^9}},
 CellLabel->
