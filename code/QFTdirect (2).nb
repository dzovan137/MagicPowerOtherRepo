Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Mathematica", " ", "has", " ", "internat", " ", "function", " ", "to", 
    " ", "generate", " ", "a", " ", "discrete", " ", "Fourier", " ", 
    "transform", " ", "matrix"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
