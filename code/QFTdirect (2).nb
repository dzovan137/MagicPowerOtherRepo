Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Generated", " ", "by", " ", "the", " ", "4", " ", "Pauli", " ", "strings",
     " ", "on", " ", "1", " ", "qubit", " ", "but", " ", "taken", " ", "to", 
    " ", "4", " ", "times", " ", "replicated", " ", "space"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PauliString1", "[", "i_", "]"}], ":=", 
     RowBox[{"PauliMatrix", "[", "i", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}], ",", 
          RowBox[{"PauliString1", "[", "i", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generated", " ", "by", " ", "the", " ", "16", " ", "Pauli", " ", 
     "strings", " ", "on", " ", "2", " ", "qubits", " ", "but", " ", "taken", 
     " ", "to", " ", "4", " ", "times", " ", "replicated", " ", "space"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PauliString2", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "i", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "16"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}], ",", 
          RowBox[{"PauliString2", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generated", " ", "by", " ", "the", " ", "16", " ", "Pauli", " ", 
     "strings", " ", "on", " ", "2", " ", "qubits", " ", "but", " ", "taken", 
     " ", "to", " ", "4", " ", "times", " ", "replicated", " ", "space"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PauliString3", "[", 
      RowBox[{"i_", ",", "j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "i", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "k", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Q3", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "64"}], ")"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], ",", 
          RowBox[{"PauliString3", "[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PauliString4", "[", 
      RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "i", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "k", "]"}], "]"}], ",", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"PauliMatrix", "[", "l", "]"}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{{3.923471270162422*^9, 3.9234714163197947`*^9}, {
   3.923471451824225*^9, 3.9234716122548237`*^9}, 3.9234716565591583`*^9, {
   3.923471691086801*^9, 3.9234717252147017`*^9}, 3.923471939580326*^9, {
   3.923472120208914*^9, 3.923472141138876*^9}, {3.92347218857486*^9, 
   3.923472217259473*^9}, 3.9234723536198483`*^9, 3.9234724035092487`*^9, {
   3.923472493550797*^9, 3.9234725062584553`*^9}, 3.923473099649705*^9, {
   3.9245852132475348`*^9, 3.924585311813582*^9}, {3.924585369939536*^9, 
   3.924585414897122*^9}, {3.924585508794363*^9, 3.924585543366477*^9}, {
   3.924586601912554*^9, 3.9245866975338*^9}, {3.92459450239159*^9, 
   3.924594508267725*^9}, {3.9245945454739037`*^9, 3.9245945862134867`*^9}, {
   3.924600708595747*^9, 3.924600857234375*^9}, {3.9258822790312257`*^9, 
